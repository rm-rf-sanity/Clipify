{
  "name": "clipify",
  "version": "0.2.1",
  "description": "A local-first Windows soundboard with dual-output audio routing.",
  "private": true,
  "type": "module",
  "author": "Clipify contributors",
  "license": "UNLICENSED",
  "main": "electron/main.cjs",
  "scripts": {
    "postinstall": "install-electron",
    "dev": "node scripts/dev.mjs",
    "start": "electron .",
    "build": "tsc --noEmit && vite build",
    "test": "node --test tests/*.test.cjs",
    "test:desktop": "node scripts/smoke.mjs",
    "test:package": "node scripts/verify-package.mjs",
    "package": "npm run build && electron-builder --win portable --x64",
    "package:dir": "npm run build && electron-builder --win --dir --x64"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  },
  "build": {
    "appId": "app.clipify.desktop",
    "productName": "Clipify",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "electron/**/*", "assets/icon.png", "package.json", "COPYRIGHT", "THIRD_PARTY_NOTICES.md"],
    "extraFiles": [
      { "from": "COPYRIGHT", "to": "COPYRIGHT-Clipify.txt" },
      { "from": "THIRD_PARTY_NOTICES.md", "to": "THIRD_PARTY_NOTICES.md" }
    ],
    "win": { "target": ["portable"], "icon": "assets/icon.ico", "signExecutable": false },
    "portable": { "artifactName": "Clipify-${version}-win-x64.exe" }
  }
}
